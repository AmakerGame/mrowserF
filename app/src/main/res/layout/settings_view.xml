<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        android:text="@string/settings"
        android:textColor="@color/on_surface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Playback -->
            <TextView
                style="@style/SettingsCategoryLabel"
                android:layout_marginTop="0dp"
                android:text="@string/category_playback" />

            <LinearLayout
                android:id="@+id/settingsAutoOpenRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/auto_open_title" />

                <TextView
                    android:id="@+id/settingsAutoOpenValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <!-- Browsing -->
            <TextView
                style="@style/SettingsCategoryLabel"
                android:text="@string/category_browsing" />

            <LinearLayout
                android:id="@+id/settingsPopupRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/block_popups_title" />

                <TextView
                    android:id="@+id/settingsPopupValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsDesktopModeRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/desktop_mode_title" />

                <TextView
                    android:id="@+id/settingsDesktopModeValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsSearchEngineRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/search_engine_title" />

                <TextView
                    android:id="@+id/settingsSearchEngineValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsClearOnExitRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/clear_on_exit_title" />

                <TextView
                    android:id="@+id/settingsClearOnExitValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <!-- Appearance -->
            <TextView
                style="@style/SettingsCategoryLabel"
                android:text="@string/category_appearance" />

            <LinearLayout
                android:id="@+id/settingsCursorRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/cursor_speed_title" />

                <TextView
                    android:id="@+id/settingsCursorValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsZoomRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/zoom_title" />

                <TextView
                    android:id="@+id/settingsZoomValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsLanguageRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/language_title" />

                <TextView
                    android:id="@+id/settingsLanguageValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <!-- About -->
            <TextView
                style="@style/SettingsCategoryLabel"
                android:text="@string/category_about" />

            <LinearLayout
                android:id="@+id/settingsVersionRow"
                style="@style/SettingsRow"
                android:focusable="false"
                android:background="@null">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/about_version" />

                <TextView
                    android:id="@+id/settingsVersionValue"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsGithubForkRow"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/about_github_fork" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsGithubOriginalRow"
                style="@style/SettingsRow"
                android:layout_marginBottom="0dp">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/about_github_original" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
